# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# AWS S3 Configuration (for photo storage)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_PHOTO_BUCKET=app-tt-photos

# OpenCage API (for geocoding)
OPENCAGE_API_KEY=your_opencage_api_key

# Google API (for tag suggestions)
GOOGLE_API_KEY=your_google_api_key

# Gemini API (for AI-powered title suggestions)
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Project ID (required for Gemini API billing / quota attribution)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# Optional: Server Port (defaults to 3001)
PORT=3001

# PostgreSQL Database Connection
DATABASE_URL=postgresql://localhost:5432/trip_tracker

